<Window x:Class="CanAIRy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanAIRy — Wireless Display Casting" Icon="Assets/CanAIRy.ico"
        Width="860" Height="690" MinWidth="780" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <Grid Margin="26,20,26,10">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="48" Height="48" CornerRadius="12" Background="Transparent" ClipToBounds="True">
          <Image Source="Assets/CanAIRy.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="CanAIRy" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Wireless Display Casting" Margin="0,1,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Padding="12,7" Background="{DynamicResource SelectionBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SubtleBrush}" Margin="0,0,7,0" />
          <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <TabControl Grid.Row="1" Margin="20,0,20,20">
      <TabItem Header="Cast">
        <Grid Margin="6,12,6,6">
          <Grid.RowDefinitions><RowDefinition Height="188" /><RowDefinition Height="132" /><RowDefinition Height="112" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Destination" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Apple TV on this network" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Padding="12,7" MinHeight="34" Click="RefreshDevices_Click" />
              </Grid>
              <ComboBox x:Name="ReceiverBox" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="Selection_Changed">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
                      <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center">
                        <Viewbox Width="19" Height="19"><Path Fill="{DynamicResource AccentBrush}" Data="M2,3 H22 A2,2 0 0 1 24,5 V17 A2,2 0 0 1 22,19 H14 V21 H18 V23 H6 V21 H10 V19 H2 A2,2 0 0 1 0,17 V5 A2,2 0 0 1 2,3 M2,5 V17 H22 V5 Z" /></Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Model}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock x:Name="ReceiverDetail" Grid.Row="2" Margin="2,7,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="What to share" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="Screen or individual window" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Choose…" Padding="12,7" MinHeight="34" Click="ChooseSource_Click" />
              </Grid>
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ComboBox x:Name="SourceBox" Visibility="Collapsed" SelectionChanged="Selection_Changed" />
                <Border Width="104" Height="70" HorizontalAlignment="Left" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                  <Grid>
                    <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Viewbox Width="27" Height="27"><Path Fill="{DynamicResource MutedBrush}" Data="M2,3 H22 A2,2 0 0 1 24,5 V17 A2,2 0 0 1 22,19 H14 V21 H18 V23 H6 V21 H10 V19 H2 A2,2 0 0 1 0,17 V5 A2,2 0 0 1 2,3 M2,5 V17 H22 V5 Z" /></Viewbox>
                    </StackPanel>
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="PreviewTitle" Text="Entire desktop" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="SelectedSourceSubtitle" Text="All screens and apps" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="18" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Width="130">
                <TextBlock Text="Picture" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Quality and motion" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Frame rate" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" />
                <ComboBox x:Name="FpsBox" MinHeight="44" SelectedIndex="0"><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" /></ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Quality" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" />
                <ComboBox x:Name="BitrateBox" MinHeight="44" SelectedIndex="0"><ComboBoxItem Content="Automatic" Tag="0" /><ComboBoxItem Content="Balanced · 4.5 Mbps" Tag="4500" /><ComboBoxItem Content="High · 8 Mbps" Tag="8000" /></ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="6" VerticalAlignment="Center">
                <TextBlock Text="Pointer" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                <CheckBox x:Name="CursorCheck" Content="Show cursor" IsChecked="True" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="18" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="StartInTrayCheck" Content="Start minimized to tray" IsChecked="True" Click="Preference_Click" />
                <CheckBox x:Name="LaunchAtSignInCheck" Content="Launch at sign-in" Margin="0,10,0,0" Click="Preference_Click" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PairButton" Content="Pair again" Click="Pair_Click" />
                <Button x:Name="StopButton" Content="Stop" Margin="9,0" Click="Stop_Click" IsEnabled="False" />
                <Button x:Name="StartButton" Content="Start casting" Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Activity">
        <Border Style="{StaticResource CardStyle}" Margin="6,12,6,6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Connection activity" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="Discovery, pairing, and streaming messages" Margin="0,3,0,14" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <TextBox x:Name="LogBox" Grid.Row="1" Padding="12" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
          </Grid>
        </Border>
      </TabItem>

      <TabItem Header="About">
        <Grid Margin="6,12,6,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Image Source="Assets/CanAIRy.png" Width="120" Height="120" Stretch="Uniform" />
              <TextBlock Text="CanAIRy" FontSize="27" FontWeight="SemiBold" Margin="0,14,0,0" />
              <TextBlock Text="Wireless Display Casting" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock x:Name="VersionText" Text="Version 1.0.0" Margin="0,7,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="About" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Text="Cast your Windows desktop or an individual app to Apple TV over your local network." Margin="0,8,0,16" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MutedBrush}" />
              <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />
              <Grid Grid.Row="3" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Created by" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="Bobby Glidwell" FontWeight="SemiBold" /></Grid>
              <Border Grid.Row="4" Background="{DynamicResource DividerBrush}" />
              <Grid Grid.Row="5" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Contact" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="sintex+github@gmail.com" FontWeight="SemiBold" /></Grid>
              <StackPanel Grid.Row="6" VerticalAlignment="Bottom"><TextBlock Text="Follows your Windows light or dark theme" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="© 2026 Bobby Glidwell" Margin="0,6,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="11" /></StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
