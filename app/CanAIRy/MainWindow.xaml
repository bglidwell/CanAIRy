<Window x:Class="CanAIRy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanAIRy — Wireless Display Casting" Icon="Assets/CanAIRy.ico"
        Width="900" Height="760" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Margin="28,24,28,14">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="54" Height="54" CornerRadius="13" Background="Transparent" ClipToBounds="True">
          <Image Source="Assets/CanAIRy.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="CanAIRy" FontSize="27" FontWeight="SemiBold" />
          <TextBlock Text="Wireless Display Casting" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Padding="13,8" Background="{DynamicResource SelectionBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource SubtleBrush}" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" FontSize="13" />
        </StackPanel>
      </Border>
    </Grid>

    <TabControl Grid.Row="1" Margin="22,0,22,22" SelectedIndex="0">
      <TabItem Header="Cast">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="6,16,6,6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Destination" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Choose an Apple TV on this network" Margin="0,3,0,14" Foreground="{DynamicResource MutedBrush}" />
                  <ComboBox x:Name="ReceiverBox" SelectionChanged="Selection_Changed">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /></Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SelectionBrush}" VerticalAlignment="Center">
                            <Viewbox Width="21" Height="21">
                              <Path Fill="{DynamicResource AccentBrush}" Data="M2,3 H22 A2,2 0 0 1 24,5 V17 A2,2 0 0 1 22,19 H14 V21 H18 V23 H6 V21 H10 V19 H2 A2,2 0 0 1 0,17 V5 A2,2 0 0 1 2,3 M2,5 V17 H22 V5 Z" />
                            </Viewbox>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock x:Name="ReceiverDetail" Margin="2,8,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Margin="14,48,0,0" VerticalAlignment="Top" Click="RefreshDevices_Click" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="What to share" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="Cast the full desktop or one visible app" Margin="0,3,0,14" Foreground="{DynamicResource MutedBrush}" />
                  <ComboBox x:Name="SourceBox" SelectionChanged="Selection_Changed">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition /></Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" VerticalAlignment="Center">
                            <Grid>
                              <Path x:Name="FallbackSourceIcon" Width="21" Height="17" Stretch="Fill" Fill="{DynamicResource MutedBrush}" Visibility="Collapsed"
                                    Data="M2,1 H22 A2,2 0 0 1 24,3 V15 A2,2 0 0 1 22,17 H14 V20 H18 V22 H6 V20 H10 V17 H2 A2,2 0 0 1 0,15 V3 A2,2 0 0 1 2,1 M2,3 V15 H22 V3 Z" />
                              <Image Source="{Binding AppIcon}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding AppIcon}" Value="{x:Null}">
                            <Setter TargetName="FallbackSourceIcon" Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Border Margin="0,14,0,0" Height="170" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                      <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                      <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Preview" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a desktop or app to see it here" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                      </StackPanel>
                      <Border VerticalAlignment="Bottom" Background="#99000000" Padding="10,6">
                        <TextBlock x:Name="PreviewTitle" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh apps" Margin="14,48,0,0" VerticalAlignment="Top" Click="RefreshSources_Click" />
              </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Picture" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Tune smoothness and network usage" Margin="0,3,0,16" Foreground="{DynamicResource MutedBrush}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Frame rate" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                    <ComboBox x:Name="FpsBox" SelectedIndex="0">
                      <ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Quality" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                    <ComboBox x:Name="BitrateBox" SelectedIndex="0">
                      <ComboBoxItem Content="Automatic" Tag="0" />
                      <ComboBoxItem Content="Balanced · 4.5 Mbps" Tag="4500" />
                      <ComboBoxItem Content="High · 8 Mbps" Tag="8000" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Pointer" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,14" />
                    <CheckBox x:Name="CursorCheck" Content="Show mouse cursor" IsChecked="True" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <CheckBox x:Name="StartInTrayCheck" Content="Start minimized to tray" IsChecked="True" Margin="0,0,24,0" Click="Preference_Click" />
                      <CheckBox x:Name="LaunchAtSignInCheck" Content="Launch at sign-in" Click="Preference_Click" />
                    </StackPanel>
                    <Expander Header="Connection details" Margin="0,16,0,0" VerticalAlignment="Top">
                      <TextBox x:Name="LogBox" Margin="0,9,0,0" Height="88" Padding="10" IsReadOnly="True"
                               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                    </Expander>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PairButton" Content="Pair again" Click="Pair_Click" />
                    <Button x:Name="StopButton" Content="Stop" Margin="9,0" Click="Stop_Click" IsEnabled="False" />
                    <Button x:Name="StartButton" Content="Start casting" Click="Start_Click" Style="{StaticResource PrimaryButtonStyle}" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="6,16,6,6">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="620" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource CardStyle}" Padding="34">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="116" Height="116" CornerRadius="25" Background="Transparent" ClipToBounds="True">
                    <Image Source="Assets/CanAIRy.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <TextBlock Text="CanAIRy" FontSize="30" FontWeight="SemiBold" Margin="0,18,0,0" HorizontalAlignment="Center" />
                  <TextBlock Text="Wireless Display Casting" FontSize="15" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Cast your Windows desktop or an individual app to Apple TV over your local network."
                             Margin="24,22,24,0" TextAlignment="Center" TextWrapping="Wrap"
                             Foreground="{DynamicResource MutedBrush}" LineHeight="21" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="1" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Text="Created by" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="1" Text="Bobby Glidwell" FontWeight="SemiBold" />
                  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                  <TextBlock Grid.Row="2" Text="Contact" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="sintex+github@gmail.com" FontWeight="SemiBold" />
                  <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                  <TextBlock Grid.Row="4" Text="Appearance" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Follows your Windows light or dark theme" />
                </Grid>
              </Border>

              <TextBlock Text="© 2026 Bobby Glidwell" Margin="0,18,0,4" HorizontalAlignment="Center"
                         Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
