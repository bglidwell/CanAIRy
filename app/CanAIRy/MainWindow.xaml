<Window x:Class="CanAIRy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CanAIRy — Wireless Display Casting" Icon="Assets/CanAIRy.ico"
        Width="830" Height="680" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Width="58" Height="58" CornerRadius="13" Background="White" ClipToBounds="True" HorizontalAlignment="Left">
          <Image Source="Assets/CanAIRy.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="CanAIRy" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="Wireless Display Casting" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Grid>
      <Border Grid.Column="1" Padding="13,7" Background="#E7EEFf" CornerRadius="16" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#98A2B3" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Margin="0,25,0,0" Padding="24" Background="{StaticResource CardBrush}" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Apple TV" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
          <ComboBox x:Name="ReceiverBox" DisplayMemberPath="DisplayName" SelectionChanged="Selection_Changed" />
          <TextBlock x:Name="ReceiverDetail" Margin="2,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Margin="14,24,0,0" Click="RefreshDevices_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="0,14,0,0" Padding="24" Background="{StaticResource CardBrush}" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Share" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
          <ComboBox x:Name="SourceBox" />
          <TextBlock Text="Choose the full desktop or one visible app window." Margin="2,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh apps" Margin="14,24,0,0" Click="RefreshSources_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="0,14,0,0" Padding="24" Background="{StaticResource CardBrush}" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Frame rate" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="FpsBox" SelectedIndex="0"><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" /></ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ComboBox x:Name="BitrateBox" SelectedIndex="0"><ComboBoxItem Content="Automatic" Tag="0" /><ComboBoxItem Content="Balanced (4.5 Mbps)" Tag="4500" /><ComboBoxItem Content="High (8 Mbps)" Tag="8000" /></ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Pointer" FontWeight="SemiBold" Margin="0,0,0,13" />
          <CheckBox x:Name="CursorCheck" Content="Show mouse cursor" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PairButton" Content="Pair again" Click="Pair_Click" />
        <Button x:Name="StopButton" Content="Stop" Margin="10,0" Click="Stop_Click" IsEnabled="False" />
        <Button x:Name="StartButton" Content="Start mirroring" Click="Start_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="StartInTrayCheck" Content="Start in tray" IsChecked="True" Margin="0,0,20,0" Click="Preference_Click" />
        <CheckBox x:Name="LaunchAtSignInCheck" Content="Launch at sign-in" Click="Preference_Click" />
      </StackPanel>
      <Expander Grid.Row="1" Header="Connection details" Margin="0,14,0,0" VerticalAlignment="Top">
        <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="100" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" />
      </Expander>
    </Grid>
  </Grid>
</Window>
